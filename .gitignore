.env
.env.local
.env.*.local

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ── OS metadata ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE task-management state (Qodo) ─────────────────────────────────────────
.qodo/
